# The Hub's settings, as a file instead of twelve things typed on one line.
#
# Copy this to `.env` in this directory and fill in what you need. That file is
# gitignored and must stay that way — it is the one thing here that holds
# credentials. Nothing in this example is a real value.
#
#     cp env.example .env
#     npm run dev
#
# Every line is optional. With none of them set the Hub runs on its built-in
# sample schedule and its own SQLite file, which is the point of the default.
# Anything that reaches the outside world stays off until a line here turns it
# on, so adding one variable at a time is a safe way to work.


# --- Where the schedule comes from ------------------------------------------
#
# `seed` (the default) is the sample data. `smartsheet` is the real thing and
# needs the token and the sheet ids below.

# DATA_SOURCE=smartsheet

# `mirror` is `smartsheet` with a local copy in front of it. The Hub reads the
# copy, which is pulled on a timer; every write still goes to Smartsheet
# through exactly the same path, and Smartsheet stays the system of record.
# The point is that reads stop costing a round trip to another company's API,
# and that a Smartsheet outage stops being a Hub outage — the copy is still
# there, and the freshness page says how old it is.
#
# It needs a database to keep the copy in, so this and HUB_DB_URL go together.
# Everything under "Where the schedule comes from" still applies: the mirror
# is a Smartsheet source underneath and takes the same token and sheet ids.
#
# The cost, said out loud: a read can be as much as MIRROR_SYNC_MINUTES old.
# The one read that is never mirrored is the check that guards a write, which
# always asks Smartsheet — comparing the sheet against a copy of itself would
# make the concurrency check decorative.

# DATA_SOURCE=mirror
# MIRROR_SYNC_MINUTES=10
# MIRROR_UPSTREAM=seed     # mirror the sample data instead, to try the shape
                           # of it without a Smartsheet token

# A service token, not somebody's personal one: it is the account the Hub acts
# as, and a personal token stops working the day that person leaves.
# Smartsheet: Account -> Personal Settings -> API Access.
# SMARTSHEET_TOKEN=

# Each sheet, by its id — the long number in the sheet's URL, or from
# File -> Properties.
# The schedule also takes several ids, separated by commas, for a team that
# starts a fresh sheet each year. Writing back is refused while it does —
# a row id does not say which sheet it belongs to.
# SMARTSHEET_CONTENT_SHEET_ID=       # the commissioning schedule
# The calendar reads several sheets if a team keeps several — holidays in
# one, leave in another, shows in a third. Separate the ids with commas.
# SMARTSHEET_EVENTS_SHEET_ID=        # leave, public holidays, shows
# SMARTSHEET_PEOPLE_SHEET_ID=        # the team
# SMARTSHEET_SESSIONS_SHEET_ID=      # the workshop programme
# SMARTSHEET_SIGNUPS_SHEET_ID=       # one row per person per session
# SMARTSHEET_ACCESS_SHEET_ID=        # who may sign in, and their rights
# SMARTSHEET_TRENDS_SHEET_ID=        # TFDB published trend profiles
# SMARTSHEET_METRICS_SHEET_ID=       # the KPIs being tracked
# SMARTSHEET_KPI_SHEET_ID=           # readings: Metric ID, Person, Date, Value

# Smartsheet is regional. A European account is served from api.smartsheet.eu,
# and pointing a UK team's Hub at the US endpoint either fails or moves their
# data across a border nobody chose.
# SMARTSHEET_API=https://api.smartsheet.eu/2.0


# --- Changing the sheet, rather than only reading it ------------------------
#
# Off unless this says otherwise. Worth leaving off until you have watched the
# Hub read your real sheets correctly for a while: everything else here is a
# read, and this is the one line that lets it write.

# SMARTSHEET_WRITE=1

# The same write path against the sample schedule, in memory, so the screens
# can be tried without a token and without touching anything real.
# SEED_WRITES=1


# --- Google Sheets ----------------------------------------------------------
#
# A service-account JSON key, named by a studio connection rather than used
# directly. Share the sheet with the service account's own address, the way
# you would share it with a person.

# GOOGLE_SHEETS_KEY=


# --- AI note drafting -------------------------------------------------------
#
# Without a key the Draft button is still there and says it is not configured,
# which is the honest version of hiding it.

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite


# --- Telling people things --------------------------------------------------
#
# Nothing sends itself unless the schedule is on. The one exception is an @
# mention in a note, which goes as the note is saved.

# NOTIFY_SCHEDULE=1
# NOTIFY_HOUR=8                      # local time
# NOTIFY_EMAIL_URL=                  # a Workspace relay taking {to, subject, text, html}
# NOTIFY_CHAT_WEBHOOK=               # the team's Google Chat space
# HUB_URL=https://forecasters.wgsn.com   # so a notice can carry a link that works


# --- Database ---------------------------------------------------------------
#
# This is the Hub's own tables — notes, sign-ups, saved views, studio
# connections, the write log. Not the schedule: where that comes from is
# DATA_SOURCE, at the top of this file, and the two are separate questions.
#
# SQLite by default, in a file beside the server. Postgres is the one change to
# make before more than one instance runs — every query is plain SQL and moves
# unchanged.

# HUB_DB=./data/hub.db
# HUB_DB_URL=postgres://user:password@host:5432/hub
# HUB_DB_POOL=10

# The `docker compose up -d` container, which is what the line above looks
# like on a laptop. Port 5433 because a Homebrew Postgres already holds 5432 —
# see docker-compose.yml for why that particular collision is worth avoiding.
# The password is in that file too, and is not a secret.

# HUB_DB_URL=postgres://hub:hub-local-only@localhost:5433/hub

# The schema is created on boot by `CREATE TABLE IF NOT EXISTS`, so there is
# no migration step and nothing to run first. An empty database is the normal
# starting state; `npm run doctor` says how many tables it found, which is how
# you tell "connected, not yet booted" from "connected to the wrong one".


# --- Signing in -------------------------------------------------------------
#
# `dev` enables the account switcher, which is right on a laptop and refuses to
# start with NODE_ENV=production. `proxy` reads the verified address from a
# header an SSO proxy sets, and is what a deployment uses.

# AUTH_MODE=proxy
# AUTH_EMAIL_HEADER=x-forwarded-email
# PORT=3001

# --- Who runs this ----------------------------------------------------------
#
# Rights normally come from the access sheet. This is the exception and the way
# back in: before an access sheet exists nobody can be an admin at all, so the
# person setting the Hub up cannot reach the studio that configures it — and
# once one exists, a row marking the wrong person inactive locks them out with
# no remedy inside the Hub. An address named here is an admin whatever the
# sheet says.

# HUB_ADMINS=someone@wgsn.com,someone.else@wgsn.com
