# Built demo page (regenerate with node demo/build.mjs)
demo/forecasters-hub.html

# A snapshot of the *real* schedule, built with `node demo/build.mjs --live`.
# It holds the commissioning schedule and the team, so it is an internal
# document: it belongs on the machine that made it, not in a repository.
demo/forecasters-hub-live.html

# The local SQLite database. HUB_DB defaults to ./data/hub.db, relative to
# wherever the server is started, so the files are ignored by name — an
# unanchored `data/` also swallowed server/src/data/, where the seed and the
# TFDB profiles live.
hub.db
hub.db-shm
hub.db-wal

# The real Content Directory, imported with tools/import-directory.mjs. It is
# a hundred and fifty colleagues and their addresses: it belongs on a machine
# somebody deliberately put it on, not in a repository or the shared demo.
# Named rather than the whole directory, for the reason above.
directory.json
